[Unit]
Description=Meikeal AI Notes dynamic blog service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ops-blog
ExecStart=/usr/bin/python3 /opt/ops-blog/server.py --host 0.0.0.0 --port 80 --directory /opt/ops-blog
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
