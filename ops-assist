#!/bin/bash
# =============================================================================
# ops-assist - Linux 运维智能巡检与日志诊断助手
# 主入口脚本，负责参数解析和命令分发
# =============================================================================

set -euo pipefail

# 脚本所在目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULES_DIR="${SCRIPT_DIR}/modules"
SCRIPTS_DIR="${SCRIPT_DIR}/scripts"
CONFIG_DIR="${SCRIPT_DIR}/config"
REPORTS_DIR="${SCRIPT_DIR}/reports"
LOGS_DIR="${SCRIPT_DIR}/logs"
SAMPLES_DIR="${SCRIPT_DIR}/samples"

# 版本号
VERSION="0.4.0"

# 检测 Python 解释器
if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
else
    PYTHON_BIN="python3"
fi

# 加载配置文件
CONFIG_FILE="${CONFIG_DIR}/ops-assist.conf"
if [[ -f "${CONFIG_FILE}" ]]; then
    source "${CONFIG_FILE}"
fi

# 确保必要目录存在
mkdir -p "${REPORTS_DIR}" "${LOGS_DIR}"

# =============================================================================
# 颜色定义
# =============================================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# =============================================================================
# 打印函数
# =============================================================================
print_banner() {
    echo -e "${BLUE}============================================${NC}"
    echo -e "${BLUE}  Linux 运维智能巡检与日志诊断助手${NC}"
    echo -e "${BLUE}  ops-assist v${VERSION}${NC}"
    echo -e "${BLUE}============================================${NC}"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

# =============================================================================
# 使用帮助
# =============================================================================
show_help() {
    cat << EOF
用法: ./ops-assist <command> [options]

命令:
  check       执行系统状态巡检（CPU、内存、磁盘、进程、端口、服务）
  log         执行日志异常分析
  diagnose    根据巡检结果生成诊断建议
  report      生成巡检报告（Markdown/HTML）
  all         执行完整巡检流程（check -> log -> diagnose -> report）
  version     显示版本信息
  help        显示此帮助信息

选项:
  -o, --output <dir>    指定报告输出目录（默认: ./reports）
  -c, --config <file>   指定配置文件路径
  -f, --log-file <file> 指定要分析的日志文件
  --format <fmt>        报告格式: markdown 或 html（默认: markdown）

示例:
  ./ops-assist check                      # 执行系统巡检
  ./ops-assist log -f /var/log/syslog     # 分析指定日志文件
  ./ops-assist all                        # 执行完整巡检流程
  ./ops-assist report --format html       # 生成 HTML 格式报告

配置文件: config/ops-assist.conf
日志目录: logs/
报告目录: reports/
EOF
}

show_version() {
    echo "ops-assist v${VERSION}"
}

# =============================================================================
# 命令分发
# =============================================================================
run_check() {
    print_info "开始执行系统状态巡检..."
    if [[ -x "${MODULES_DIR}/check_system.sh" ]]; then
        bash "${MODULES_DIR}/check_system.sh" "$@"
    else
        print_error "巡检模块不存在: ${MODULES_DIR}/check_system.sh"
        return 1
    fi
}

run_log_analyze() {
    print_info "开始执行日志异常分析..."
    if [[ -x "${MODULES_DIR}/log_analyzer.sh" ]]; then
        bash "${MODULES_DIR}/log_analyzer.sh" "$@"
    else
        print_error "日志分析模块不存在: ${MODULES_DIR}/log_analyzer.sh"
        return 1
    fi
}

run_diagnose() {
    print_info "开始生成诊断建议..."
    if [[ -f "${SCRIPTS_DIR}/diagnose.py" ]]; then
        ${PYTHON_BIN} "${SCRIPTS_DIR}/diagnose.py" "$@"
    else
        print_error "诊断模块不存在: ${SCRIPTS_DIR}/diagnose.py"
        return 1
    fi
}

run_report() {
    print_info "开始生成巡检报告..."
    if [[ -f "${SCRIPTS_DIR}/report.py" ]]; then
        ${PYTHON_BIN} "${SCRIPTS_DIR}/report.py" "$@"
    else
        print_error "报告生成模块不存在: ${SCRIPTS_DIR}/report.py"
        return 1
    fi
}

run_all() {
    local timestamp
    timestamp=$(date '+%Y%m%d_%H%M%S')
    print_banner
    print_info "开始完整巡检流程 (${timestamp})..."

    # 步骤1: 系统巡检
    print_info "[1/4] 执行系统状态巡检..."
    run_check "${CHECK_OUTPUT:-${LOGS_DIR}/check_${timestamp}.log}"

    # 步骤2: 日志分析
    print_info "[2/4] 执行日志异常分析..."
    run_log_analyze "${LOG_OUTPUT:-${LOGS_DIR}/log_${timestamp}.log}"

    # 步骤3: 诊断建议
    print_info "[3/4] 生成诊断建议..."
    run_diagnose --input "${LOGS_DIR}/check_${timestamp}.log" \
                 --output "${LOGS_DIR}/diagnose_${timestamp}.txt"

    # 步骤4: 生成报告
    print_info "[4/4] 生成巡检报告..."
    run_report --input "${LOGS_DIR}/check_${timestamp}.log" \
               --output "${REPORTS_DIR}/report_${timestamp}.md"

    print_success "完整巡检流程完成！"
    print_info "报告已保存至: ${REPORTS_DIR}/report_${timestamp}.md"
}

# =============================================================================
# 主入口
# =============================================================================
main() {
    # 解析子命令
    local command="${1:-help}"
    shift 2>/dev/null || true

    case "${command}" in
        check)
            run_check "$@"
            ;;
        log)
            run_log_analyze "$@"
            ;;
        diagnose)
            run_diagnose "$@"
            ;;
        report)
            run_report "$@"
            ;;
        all)
            run_all
            ;;
        version|--version|-v)
            show_version
            ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            print_error "未知命令: ${command}"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# 执行主函数
main "$@"
